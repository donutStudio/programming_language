{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build project",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "& g++ -std=c++17 -g (Get-ChildItem -Recurse -Filter *.cpp | ForEach-Object { $_.FullName }) -o app.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run project",
            "type": "shell",
            "command": ".\\app.exe",
            "dependsOn": "Build project"
        }
    ]
}